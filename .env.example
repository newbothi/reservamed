# Plantilla de secretos para docker compose.
# Recomendado: ejecute scripts/configurar-secretos.ps1, que crea .env con valores aleatorios.
# Manual: copie este archivo a .env y reemplace cada valor. .env nunca se sube a Git.
#
# Reglas: JWT_KEY >= 32 caracteres, TOTP_KEY y BFF_SESSION_KEY = 32 bytes aleatorios en base64url, ML_API_KEY >= 24, claves de RabbitMQ >= 16.
# Las claves SQL deben cumplir la política de SQL Server (mayúscula, minúscula, número y símbolo).
SA_PASSWORD=
JWT_KEY=
# F2: clave AES de los secretos TOTP (base64url, 32 bytes) y clave de la cookie de sesión del BFF.
# Si cambia TOTP_KEY, el personal debe volver a enrolar su autenticador.
TOTP_KEY=
BFF_SESSION_KEY=
# F3: clave de los lectores de huella (API valida, simulador del BFF firma).
HUELLA_KEY=
ML_API_KEY=
# Administrador de RabbitMQ (solo consola y configuración inicial)
RABBIT_USER=reservamed
RABBIT_PASS=
# Un usuario por servicio (hallazgo A5)
SQL_API_PASS=
SQL_WORKER_PASS=
SQL_ML_PASS=
SQL_ML_SEED_PASS=
# F4: llave maestra de SQL Server (TDE y respaldos cifrados). Guarde una copia: sin ella no se
# pueden restaurar los respaldos en otro servidor.
SQL_TDE_PASS=
RABBIT_API_PASS=
RABBIT_WORKER_PASS=
RABBIT_ML_PASS=
# Webpay Plus, ambiente de integración de Transbank (clave pública de su documentación).
# En producción: la clave del comercio real.
WEBPAY_API_KEY=
# Opcional: puerto HTTP del host (solo redirige a HTTPS). Cámbielo si Windows tiene ocupado el 80.
# HTTP_PORT=8081
