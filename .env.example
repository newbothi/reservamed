# Plantilla de secretos para docker compose.
# Recomendado: ejecute scripts/configurar-secretos.ps1, que crea .env con valores aleatorios.
# Manual: copie este archivo a .env y reemplace cada valor. .env nunca se sube a Git.
#
# Reglas: JWT_KEY >= 32 caracteres, ML_API_KEY >= 24, claves de RabbitMQ >= 16.
# Las claves SQL deben cumplir la política de SQL Server (mayúscula, minúscula, número y símbolo).
SA_PASSWORD=
JWT_KEY=
ML_API_KEY=
# Administrador de RabbitMQ (solo consola y configuración inicial)
RABBIT_USER=reservamed
RABBIT_PASS=
# Un usuario por servicio (hallazgo A5)
SQL_API_PASS=
SQL_WORKER_PASS=
SQL_ML_PASS=
SQL_ML_SEED_PASS=
RABBIT_API_PASS=
RABBIT_WORKER_PASS=
RABBIT_ML_PASS=
# Webpay Plus, ambiente de integración de Transbank (clave pública de su documentación).
# En producción: la clave del comercio real.
WEBPAY_API_KEY=
